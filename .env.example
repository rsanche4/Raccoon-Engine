# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- AWS Bedrock (required) ---
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=PLACEHOLDER
AWS_SECRET_ACCESS_KEY=PLACEHOLDER
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-core-v1:1

# --- Tavily: market research + the agent's web search (recommended) ---
# https://tavily.com  — 1,000 free credits/month
TAVILY_API_KEY=PLACEHOLDER

# --- Replicate: music and sound effects (optional) ---
# https://replicate.com/account/api-tokens
# Without this, audio tools write silent placeholder .wav files.
REPLICATE_API_TOKEN=PLACEHOLDER
REPLICATE_MUSIC_MODEL=meta/musicgen

# --- Where the engine lives. Defaults to the current directory. ---
RACCOON_REPO=.
